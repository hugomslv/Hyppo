{
    "manifest_version": 3,
    "name": "Time Manager by Hyppo",
    "version": "1.2.0",
    "description": "Extension de gestion du temps avec interface de configuration",
    "permissions": [
        "tabs", 
        "scripting", 
        "storage"
    ],
    "host_permissions": [
        "https://launchpad.wd.pnet.ch/*"
    ],
      "content_scripts": [
    {
     "matches": ["*://*.pnet.ch/*", "*://*.workday.com/*", "*://*/launchpad.wd.pnet.ch/*"],
      "js": ["api.js", "config.js", "translations.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "clock.png",
        "default_title": "Time Manager - Configuration"
    },
    "icons": {
        "16": "clock.png",
        "48": "clock.png",
        "128": "clock.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "time-manager@hyppo",
            "strict_min_version": "109.0"
        }
    }
}